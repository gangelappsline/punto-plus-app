# Variables de compilación de Punto+ (Flutter --dart-define).
#
# No son secretos: cualquier valor pasado con --dart-define queda dentro del
# binario y puede extraerse. Las credenciales OAuth viven en el backend.
#
# Uso local:
#   flutter run --dart-define-from-file=.env
#
# Uso en CI/CD (GitHub Actions, Codemagic, etc.):
#   flutter build apk --release --dart-define-from-file=env/prod.json

# URL base de la API (Laravel + Passport). Debe incluir el prefijo /api.
API_BASE_URL=https://api.punto-plus.com.mx/api

# Tiempos máximos de red en segundos.
API_CONNECT_TIMEOUT_SECONDS=20
API_RECEIVE_TIMEOUT_SECONDS=20

# dev | staging | prod
ENV=dev

# Clave de Google Maps para Android/iOS.
# Vacía = la app usa la vista esquemática del mapa (MapCanvas).
GOOGLE_MAPS_API_KEY=

# Firma de release de Android (opcional).
# key.properties o estas variables de entorno evitan versionar el keystore:
#   KEYSTORE_PATH=/ruta/a/punto-plus-release.jks
#   KEYSTORE_PASSWORD=...
#   KEY_ALIAS=puntoplus
#   KEY_PASSWORD=...
